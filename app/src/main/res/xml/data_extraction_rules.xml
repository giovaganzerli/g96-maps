<?xml version="1.0" encoding="utf-8"?>
<!-- The same list as backup_rules.xml (Android 12 and later read this file; keep the two in step).
     The vehicle garage (vela_vehicles.xml) is left out on purpose: it holds a plate and vehicle
     details that stay on the phone. The AI keys (vela_ai.xml) are excluded too. -->
<data-extraction-rules xmlns:tools="http://schemas.android.com/tools">
    <cloud-backup>
        <include domain="sharedpref" path="vela_settings.xml" />
        <include domain="sharedpref" path="vela_onboarding.xml" />
        <include domain="sharedpref" path="vela_notices.xml" />
        <include domain="sharedpref" path="vela_units.xml" />
        <include domain="sharedpref" path="vela_shortcuts.xml" />
        <include domain="sharedpref" path="vela_saved.xml" />
        <include domain="sharedpref" path="vela_saved_routes.xml" />
        <include domain="sharedpref" path="vela_lists.xml" />
        <include domain="sharedpref" path="vela_recents.xml" />
        <include domain="sharedpref" path="vela_recent_places.xml" />
        <include domain="file" path="trips/" />
        <include domain="file" path="fonts/ui.ttf" />
        <exclude domain="sharedpref" path="vela_vehicles.xml" tools:ignore="FullBackupContent" />
        <exclude domain="sharedpref" path="vela_ai.xml" tools:ignore="FullBackupContent" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="vela_settings.xml" />
        <include domain="sharedpref" path="vela_onboarding.xml" />
        <include domain="sharedpref" path="vela_notices.xml" />
        <include domain="sharedpref" path="vela_units.xml" />
        <include domain="sharedpref" path="vela_shortcuts.xml" />
        <include domain="sharedpref" path="vela_saved.xml" />
        <include domain="sharedpref" path="vela_saved_routes.xml" />
        <include domain="sharedpref" path="vela_lists.xml" />
        <include domain="sharedpref" path="vela_recents.xml" />
        <include domain="sharedpref" path="vela_recent_places.xml" />
        <include domain="file" path="trips/" />
        <include domain="file" path="fonts/ui.ttf" />
        <exclude domain="sharedpref" path="vela_vehicles.xml" tools:ignore="FullBackupContent" />
        <exclude domain="sharedpref" path="vela_ai.xml" tools:ignore="FullBackupContent" />
    </device-transfer>
</data-extraction-rules>
